# Public client configuration. Values prefixed with VITE_ are bundled into the client.
VITE_API_BASE_URL=/api
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

# Private server configuration. Replace these examples in your local environment.
SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/readerapp
BOOK_STORAGE_PATH=./storage
CORS_ALLOWED_ORIGINS=http://localhost:5173
